{
    "extends": "./node_modules/gts/tsconfig-google.json",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "build/esm",
        "resolveJsonModule": true,
        "module": "es2020",
        "moduleResolution": "node",
        "lib": [
            "ES2020"
        ],
        "sourceMap": false,
        "esModuleInterop": true
    },
    "include": [
        "src/*.ts",
        "src/*.cjs",
        "src/nodejs-common/*.ts",
        "test/**/*.ts",
        "system-test/*.ts",
        "conformance-test/*.ts",
        "conformance-test/scenarios/*.ts",
        "conformance-test/test-data/*.json",
        "internal-tooling/*.ts"
    ]
}